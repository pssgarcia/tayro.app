generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  BRAND
  INFLUENCER
  ADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  COMPLETED
}

// DEPRECATED — usado apenas por Reward.type. Não usar em novos campos de Campaign.
enum RewardType {
  MONETARY
  PRODUCT
  DISCOUNT
}

// Tipo da oferta exibida à creator antes de candidatar
enum OfferType {
  CASH
  PRODUCT
  COMMISSION
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ContentStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum MediaType {
  IMAGE
  VIDEO
  REEL
  STORY
}

enum RewardStatus {
  PENDING
  ISSUED
  DELIVERED
}

enum IgFetchStatus {
  OK
  PENDING
  FAILED
}

// ─── Core Entities ────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  role          UserRole
  isActive          Boolean        @default(true)
  refreshTokenHash  String?
  // Conta CLAIMABLE (criada via /apply/:id, senha aleatória) — presente até
  // a creator definir a senha real via POST /auth/claim. Null = já claimada
  // ou conta criada por registro normal (sempre teve senha usável).
  claimTokenHash      String?   @unique
  claimTokenExpiresAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  brand         Brand?
  influencer    Influencer?
  notifications Notification[]

  @@map("users")
}

model Brand {
  id        String     @id @default(uuid())
  userId    String     @unique
  name      String
  logoUrl   String?
  niches    String[]
  website   String?
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@map("brands")
}

model Influencer {
  id               String         @id @default(uuid())
  userId           String         @unique
  name             String
  avatarUrl        String?
  bio              String?
  instagramHandle  String?        @unique
  tiktokHandle     String?
  followersCount   Int?
  niches           String[]
  city             String?
  // Cache do Instagram — atualizado assincronamente pelo InstagramProvider
  igEngagementRate    Float?
  igRecentPosts       Json?          // [{ url, thumbnail, likes, comments }]
  igProfilePicUrl     String?
  igFetchedAt         DateTime?
  igFetchStatus       IgFetchStatus?
  // Opt-in LGPD — perfil público só é exibido quando true
  publicProfileEnabled Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt        DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  rewards      Reward[]

  @@map("influencers")
}

model Campaign {
  id          String         @id @default(uuid())
  brandId     String
  title       String
  description String
  briefUrl    String?
  status      CampaignStatus @default(DRAFT)
  niches      String[]
  maxSpots    Int
  deadline    DateTime?

  // DEPRECATED — não escrever nem expor em DTOs de oferta. Remoção em migration futura.
  rewardType  RewardType
  // DEPRECATED — não escrever nem expor em DTOs de oferta. Remoção em migration futura.
  rewardValue String

  // Termos da oferta — fonte de verdade exibida à creator antes de candidatar
  offerType             OfferType? // CASH | PRODUCT | COMMISSION
  offerAmount           Int?       // em centavos (ex: 30000 = R$300,00); só quando CASH
  offerDeadlineDays     Int?       // dias corridos após aprovação de conteúdo para pagamento/envio
  offerDescription      String?    // descrição livre (ex: "Kit Whey 900g + coqueteleira"); só quando PRODUCT
  offerCommissionPercent Float?    // percentual por venda via link/cupom da creator; só quando COMMISSION

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  applications Application[]
  rewards      Reward[]

  @@index([brandId, status])
  @@index([status, deadline])
  @@map("campaigns")
}

model Application {
  id           String            @id @default(uuid())
  campaignId   String
  influencerId String
  status       ApplicationStatus @default(PENDING)
  message      String?
  appliedAt    DateTime          @default(now())
  reviewedAt   DateTime?

  campaign    Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer  Influencer          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  submissions ContentSubmission[]
  result      PartnershipResult?

  @@unique([campaignId, influencerId])
  @@index([campaignId, status])
  @@index([influencerId, status])
  @@map("applications")
}

model ContentSubmission {
  id            String        @id @default(uuid())
  applicationId String
  mediaUrl      String
  mediaType     MediaType
  caption       String?
  status        ContentStatus @default(PENDING)
  feedback      String?
  submittedAt   DateTime      @default(now())
  reviewedAt    DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@map("content_submissions")
}

model Reward {
  id           String       @id @default(uuid())
  influencerId String
  campaignId   String
  type         RewardType
  value        String
  status       RewardStatus @default(PENDING)
  notes        String?
  issuedAt     DateTime?
  createdAt    DateTime     @default(now())

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("rewards")
}

model PartnershipResult {
  id               String      @id @default(uuid())
  applicationId    String      @unique
  reach            Int?
  impressions      Int?
  couponsUsed      Int?
  note             String?
  visibleToCreator Boolean     @default(false)
  createdAt        DateTime    @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("partnership_results")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

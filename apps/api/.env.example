# ─── Database ──────────────────────────────────────────────────────────────────
# Local dev: postgresql://tayro_user:tayro_password@localhost:5432/tayro_db
DATABASE_URL=

# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Allowed CORS origins (comma-separated)
# OBRIGATÓRIO em produção — a API NÃO sobe sem isso quando NODE_ENV=production.
# Local dev: http://localhost:5173
# Prod: https://tayro-app.vercel.app
ALLOWED_ORIGINS=

# Base do frontend — usada pra montar links em e-mails (ex: /claim?token=...)
# Local dev: http://localhost:5173
# Prod: https://tayro-app.vercel.app
FRONTEND_URL=

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Instagram ─────────────────────────────────────────────────────────────────
# stub (dev, dados determinísticos, sem chave) ou rapidapi (produção)
INSTAGRAM_PROVIDER=stub
# Só necessárias com INSTAGRAM_PROVIDER=rapidapi
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-best-experience.p.rapidapi.com
RAPIDAPI_BASE_URL=https://instagram-best-experience.p.rapidapi.com

# Todas com default seguro — só precisa setar pra mudar o comportamento padrão.
IG_FETCH_TIMEOUT_MS=10000
IG_FETCH_STALENESS_HOURS=24
# Verificação de existência de @ (GET /ig/handle/:handle) — D-19
IG_HANDLE_CHECK_TIMEOUT_MS=5000
IG_PROFILE_CACHE_TTL_MINUTES=15
IG_HANDLE_CHECK_BUDGET_PER_MINUTE=60

# ─── Observabilidade (Sentry) ─────────────────────────────────────────────────
# OBRIGATÓRIO em produção — a API NÃO sobe sem isso quando NODE_ENV=production
# (mesma regra do ALLOWED_ORIGINS). Em dev fica em branco: o SDK fica inerte.
# Projeto na região EU → o DSN tem "ingest.de.sentry.io".
SENTRY_DSN=
# Default: SENTRY_ENVIRONMENT → NODE_ENV → "development"
SENTRY_ENVIRONMENT=
# Amostragem de traces de performance, [0..1]. Default 0.1.
SENTRY_TRACES_SAMPLE_RATE=

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
# Provisionado, ainda não usado por nenhum módulo — pode deixar em branco.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# ─── Email Provider ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=stub
# Para trocar para Resend, mude EMAIL_PROVIDER=resend e preencha:
# RESEND_API_KEY=
# EMAIL_FROM=noreply@seudominio.com (precisa de domínio verificado no Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@seudominio.com

# Opcional — instrumentação do funil (roadmap.md, AGORA #0), não gate de
# lançamento. Sem valor, a notificação simplesmente não dispara (não falha o
# boot, ao contrário de FRONTEND_URL/JWT_*). Recebe um e-mail a cada conta de
# creator criada via candidatura pública.
ADMIN_NOTIFICATION_EMAIL=
